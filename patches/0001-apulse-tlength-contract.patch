-    if (snd_pcm_delay(s->ph, &delay) < 0)
-        delay = 0;
+    if (r_usec) {
+        size_t frame_size = pa_frame_size(&s->ss);
 
-    if (r_usec)
-        *r_usec = 1000 * 1000 * delay / s->ss.rate;
+        *r_usec = frame_size > 0
+                      ? pa_bytes_to_usec((uint64_t)delay * frame_size, &s->ss)
+                      : 0;
+    }
     if (negative)
         *negative = 0;
     return 0;
@@ -781,10 +853,8 @@
